# Source this file on openEuler/Ascend before starting MFE Ascend.
# Adjust device IDs after checking `npu-smi info`.

export MFE_ACCELERATOR=ascend
export ASCEND_RT_VISIBLE_DEVICES=0
export NPU_VISIBLE_DEVICES=0

# vllm-ascend 0.9.x recommends V1 Engine. Newer releases may enable it by default.
export VLLM_USE_V1=1
export VLLM_TARGET_DEVICE=npu

# Optional: reduce third-party log noise.
export MFE_VLLM_LOG_LEVEL=ERROR
export TRANSFORMERS_VERBOSITY=error
export HF_HUB_DISABLE_PROGRESS_BARS=1

# Optional test-only knobs.
# export MFE_USE_TEST_WORKER=1
# export MFE_TEST_DEVICE_CNT=4
# export MFE_TEST_WORKER_DELAY=0.2
